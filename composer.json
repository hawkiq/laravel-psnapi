{
    "name": "hawkiq/laravel-psnapi",
    "description": "A Laravel package to interact with PlayStation Network APIs and retrieve trophy data.",
    "type": "library",
    "scripts": {
        "analyse": "phpstan analyse",
        "format": "pint",
        "test": "pest"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Hawkiq\\LaravelPsnApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hawkiq\\LaravelPsnApi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hawkiq\\LaravelPsnApi\\Providers\\PsnApiServiceProvider"
            ],
            "aliases": {
                "PsnApi": "Hawkiq\\LaravelPsnApi\\Facades\\PsnApi"
            }
        }
    },
    "authors": [
        {
            "name": "hawkiq",
            "email": "info@osama.app"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "pestphp/pest": "^5.1",
        "orchestra/testbench": "^11.2",
        "phpunit/phpunit": "^13.3",
        "laravel/pint": "^1.30",
        "larastan/larastan": "^3.10"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
