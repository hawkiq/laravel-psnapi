{
    "name": "hawkiq/laravel-psnapi",
    "description": "A Laravel package to interact with PlayStation Network APIs and retrieve trophy data.",
    "type": "library",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Hawkiq\\LaravelPsnApi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hawkiq\\LaravelPsnApi\\Providers\\PsnApiServiceProvider"
            ],
            "aliases": {
                "PsnApi": "Hawkiq\\LaravelPsnApi\\Facades\\PsnApi"
            }
        }
    },
    "authors": [
        {
            "name": "hawkiq",
            "email": "info@osama.app"
        }
    ],
    "minimum-stability": "stable"
}
